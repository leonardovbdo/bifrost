# Copie para .env e ajuste se necessário (não commitado)
POSTGRES_PORT=5432
POSTGRES_DB=bifrost
POSTGRES_USER=bifrost
POSTGRES_PASSWORD=bifrost

# Auth bootstrap
BIFROST_ADMIN_USERNAME=admin
BIFROST_ADMIN_PASSWORD=change-me
BIFROST_OPERATOR_SEED_ENABLED=false
BIFROST_OPERATOR_USERNAME=operator
BIFROST_OPERATOR_PASSWORD=change-me
BIFROST_VIEWER_SEED_ENABLED=false
BIFROST_VIEWER_USERNAME=viewer
BIFROST_VIEWER_PASSWORD=change-me
BIFROST_JWT_SECRET=change-me-bifrost-dev-secret-at-least-32-chars
BIFROST_JWT_ACCESS_TTL=15m
BIFROST_JWT_REFRESH_TTL=7d
BIFROST_COOKIE_SECURE=false
BIFROST_AUDIT_RETENTION_DAYS=90

# LLM proxy (ADR-011) — chave só no servidor; sem key usa stub em dev
BIFROST_LLM_API_KEY=
BIFROST_LLM_MODEL=gemini-3.6-flash
BIFROST_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta
BIFROST_LLM_MAX_PROMPT_LENGTH=4000
BIFROST_LLM_TIMEOUT_MS=30000
BIFROST_LLM_STUB_WHEN_MISSING_KEY=true
